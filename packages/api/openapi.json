{
  "openapi": "3.1.0",
  "info": {
    "title": "Freehold API",
    "version": "0.1.0",
    "description": "Governed memory backend for AI agents, built on the Allod format."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8710",
      "description": "Local Freehold"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    },
    "schemas": {
      "RememberBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "description": "Agent name performing the write"
          },
          "content": {
            "type": "string",
            "description": "Free-text note content"
          }
        },
        "required": ["agent", "content"]
      },
      "CreateEntityBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Entity type ref, e.g. memory/Preference@1"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {}
          },
          "classification": {
            "type": "string"
          }
        },
        "required": ["agent", "type", "attributes"]
      },
      "UpdateEntityBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {}
          },
          "prior": {
            "type": "string",
            "description": "Hash of the changeset being superseded"
          }
        },
        "required": ["agent", "type", "attributes"]
      },
      "RelateBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "edgeType": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {}
          },
          "scratch": {
            "type": "boolean"
          }
        },
        "required": ["agent", "from", "to", "edgeType"]
      },
      "ClassifyBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "enum": ["model-assisted", "manual"],
            "description": "How the classification was derived; manual assertions skip the envelope rule"
          }
        },
        "required": ["agent", "nodeId", "term"]
      },
      "AttachDocumentBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["agent", "entityId", "content"]
      },
      "RegisterAgentBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"]
      },
      "ProposeOntologyBody": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "ontologyYaml": {
            "type": "string"
          }
        },
        "required": ["agent", "packageName", "ontologyYaml"]
      },
      "InstallOntologyBody": {
        "type": "object",
        "properties": {
          "docsYaml": {
            "type": "string"
          }
        },
        "required": ["docsYaml"]
      },
      "PolicyBody": {
        "type": "object",
        "properties": {
          "policy_yaml": {
            "type": "string",
            "description": "Complete replacement policy document (YAML or JSON)"
          },
          "agent": {
            "type": "string",
            "description": "Authoring agent principal; omitted means the owner proposes"
          }
        },
        "required": ["policy_yaml"]
      },
      "AdmissionResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["saved", "pending"]
          },
          "hash": {
            "type": "string"
          },
          "proposal": {},
          "rule": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["status", "hash"]
      },
      "RememberResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AdmissionResponse"
          },
          {
            "type": "object",
            "properties": {
              "noteId": {
                "type": "string"
              },
              "changeset": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ProposalView": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diff": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "before": {},
                "after": {}
              },
              "required": ["key"]
            }
          },
          "isSchemaProposal": {
            "type": "boolean"
          },
          "subject": {
            "type": ["object", "null"],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": ["id", "title"],
            "description": "The existing node this proposal targets, with its resolved title; null for creates"
          }
        },
        "required": [
          "hash",
          "agent",
          "intent",
          "summary",
          "rules",
          "diff",
          "isSchemaProposal",
          "subject"
        ]
      },
      "RecallResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "content": {},
          "author": {
            "type": "string"
          },
          "method": {
            "type": ["string", "null"],
            "description": "Provenance method (model-assisted, manual, etc.) or null for unrecorded"
          },
          "approval": {
            "type": "string",
            "description": "approval field; maps from the `status` query parameter"
          },
          "changeset": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        },
        "required": ["id", "type", "author", "method", "approval", "changeset", "score"]
      },
      "VerifyReport": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "stateHash": {
            "type": "string"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": ["id", "reason"]
            }
          }
        },
        "required": ["ok"]
      },
      "SchemaDescription": {
        "type": "object",
        "properties": {
          "entityTypes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "package": {
                  "type": "string"
                },
                "attributes": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "extends": {
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          },
          "edgeTypes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "range": {
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "parent": {
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          }
        },
        "required": ["entityTypes", "edgeTypes", "terms"]
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "defaultAgent": {
            "type": ["string", "null"],
            "description": "Default MCP agent name, if set"
          },
          "embedder": {
            "type": "string",
            "enum": ["transformers", "hash"],
            "description": "Active embedder backend"
          },
          "port": {
            "type": "number",
            "description": "Freehold's local port"
          },
          "owner": {
            "type": "string",
            "description": "The graph's owner principal; console edits sign as this name"
          },
          "graphs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphInfo"
            },
            "description": "All registered graphs"
          },
          "defaultGraph": {
            "type": "string",
            "description": "Id of the default graph"
          }
        },
        "required": ["defaultAgent", "embedder", "port", "owner"]
      },
      "MemoryIndexEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Display title derived from attributes (title, name, statement, first line)"
          },
          "approval": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Taxonomy terms from fold state"
          }
        },
        "required": ["id", "type", "title", "approval", "author", "updatedAt", "terms"]
      },
      "GraphNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "approval": {
            "type": "string"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "type", "title", "approval", "terms"]
      },
      "GraphEdge": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": ["id", "type", "from", "to"]
      },
      "MemoryGraphView": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            }
          },
          "truncated": {
            "type": "boolean",
            "description": "True when the node cap cut the listing short"
          }
        },
        "required": ["nodes", "edges", "truncated"]
      },
      "GraphInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["memory", "repo"]
          }
        },
        "required": ["id", "name", "kind"]
      },
      "RegisterGraphBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["memory", "repo"]
          }
        },
        "required": ["name", "kind"]
      },
      "UpdateGraphBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/remember": {
      "post": {
        "summary": "Write a scratch note",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RememberBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RememberResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/entities": {
      "post": {
        "summary": "Create an entity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEntityBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/entities/{id}": {
      "patch": {
        "summary": "Update an entity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEntityBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      },
      "get": {
        "summary": "Get an entity by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Entity view"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/api/v1/relations": {
      "post": {
        "summary": "Create a relation (edge)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RelateBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/classifications": {
      "post": {
        "summary": "Add a classification",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/documents": {
      "post": {
        "summary": "Attach a document",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttachDocumentBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/memories": {
      "get": {
        "summary": "List recent memories",
        "description": "Most recently indexed memories, newest first. Same result shape as recall (score is 0). The `status` query param maps to the `approval` field. With `scope=all`, returns the full workspace index instead — every non-meta node including pending proposals, as MemoryIndexEntry — and the other query params are ignored.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Set to `all` for the full workspace index (MemoryIndexEntry shape)"
            },
            "required": false,
            "name": "scope",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "author",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Max results (default 50, cap 1000)"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recent memories with provenance, or the full index with scope=all",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/RecallResult"
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MemoryIndexEntry"
                          }
                        }
                      ]
                    }
                  },
                  "required": ["results"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/graph": {
      "get": {
        "summary": "Memory graph export",
        "description": "All non-meta nodes and the typed edges between saved nodes, for the graph canvas.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Nodes and edges",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryGraphView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/recall": {
      "get": {
        "summary": "Hybrid semantic recall",
        "description": "Semantic + full-text search fused via RRF. The `status` query param maps to the `approval` field in RecallResult.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Search query (required)"
            },
            "required": true,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "author",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by approval state — maps to the `approval` field on RecallResult"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Recall results with provenance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecallResult"
                      }
                    }
                  },
                  "required": ["results"]
                }
              }
            }
          },
          "400": {
            "description": "Missing query parameter q"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/entities/{id}/traverse": {
      "get": {
        "summary": "Traverse from an entity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "edgeTypes",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": ["out", "in", "both"]
            },
            "required": false,
            "name": "direction",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "depth",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
