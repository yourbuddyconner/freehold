{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "~/lib/*": ["./src/lib/*"],
      "~/components/*": ["./src/components/*"],
      "~/routes/*": ["./src/routes/*"]
    }
  },
  "include": ["src"]
}
